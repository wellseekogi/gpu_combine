# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Legacy framework output (not used by the current Vite app)
/.next/
/.vinext/
/out/
/dist/
/.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# TypeScript and Python caches
next-env.d.ts
*.tsbuildinfo
__pycache__/
*.pyc

# Current web build
/standalone-dist/

# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/.agentworkforce/

# Generated deliverables, experiments, and temporary test data
/outputs/
/work/

# Local service state and model exports
/.relay/
/relay-model-contract.json

# Local inference deployment identities and credential hashes.
/inference.local.json
